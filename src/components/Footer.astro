---
const year = new Date().getFullYear();
---

<footer class="mt-32">
  <div class="container-wide">
    <div class="h-px" style="background:linear-gradient(90deg, transparent, var(--color-border) 20%, var(--color-border) 80%, transparent)"></div>
  </div>

  <div class="container-wide grid gap-10 py-14 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 text-base font-semibold">
        <span class="inline-block h-2 w-2 rounded-full" style="background:var(--color-accent); box-shadow:0 0 12px var(--color-accent-glow)"></span>
        Christopher Wright
      </div>
      <p class="mt-3 text-sm text-[var(--color-text-dim)] leading-relaxed">
        Principal Scientist & Principal Investigator.<br/>
        Mansfield, TX.
      </p>
    </div>

    <div>
      <h4 class="text-sm font-medium text-[var(--color-text)]">Contact</h4>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-subtle" href="mailto:cwright7101@gmail.com">cwright7101@gmail.com</a></li>
        <li><a class="link-subtle" href="mailto:cwright@grammatech.com">cwright@grammatech.com</a></li>
        <li><a class="link-subtle" href="https://www.linkedin.com/in/cmwright">LinkedIn</a></li>
        <li><a class="link-subtle" href="https://github.com/cwright7101">GitHub</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-medium text-[var(--color-text)]">Site</h4>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-subtle" href="/research">Research</a></li>
        <li><a class="link-subtle" href="/projects">Projects</a></li>
        <li><a class="link-subtle" href="/blog">Blog</a></li>
        <li><a class="link-subtle" href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>

  <div class="container-wide pb-10">
    <div class="text-xs text-[var(--color-text-dim)]">
      © {year} Christopher M. Wright
    </div>
  </div>
</footer>
