---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog" description="Notes, write-ups, and technical posts from Christopher M. Wright on firmware security, reverse engineering, and AI-assisted program analysis.">
  <PageHeader
    eyebrow="Blog"
    title="Notes & write-ups"
    lede="Technical posts on firmware analysis, reverse engineering, AI-assisted tooling, and the systems behind them."
  />

  <section class="container-wide pb-24">
    {posts.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">No posts yet — check back soon.</p>
    ) : (
      <ul class="space-y-3">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.id}/`} class="card group block">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-xl font-semibold group-hover:text-[var(--color-accent)] transition-colors">
                  {post.data.title}
                </h2>
                <time datetime={post.data.pubDate.toISOString()} class="text-xs text-[var(--color-text-dim)] whitespace-nowrap">
                  {fmt(post.data.pubDate)}
                </time>
              </div>
              <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {post.data.tags.map(t => <span class="chip">{t}</span>)}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
