---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="CV & Resume">
  <PageHeader
    eyebrow="CV & Resume"
    title="Download my CV"
    lede="A current overview of my technical expertise, research areas, program leadership, and publications, with a detailed history of my professional and academic work."
  />

  <section class="container-wide pb-24">
    <div class="card max-w-2xl">
      <div class="flex items-center justify-between gap-4">
        <div>
          <div class="text-xs uppercase tracking-wider text-[var(--color-text-dim)]">PDF · current version</div>
          <h2 class="mt-2 text-xl font-semibold">Christopher M. Wright — Resume</h2>
        </div>
        <a href="/cv/christopher-wright-resume.pdf" download class="btn-primary whitespace-nowrap">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </a>
      </div>
      <p class="mt-6 text-sm text-[var(--color-text-muted)]">
        Need a tailored version for collaboration, proposals, or a specific engagement?
        <a class="link-underline" href="/contact">Get in touch</a> and I'll send something matched to your needs.
      </p>
    </div>
  </section>
</BaseLayout>
